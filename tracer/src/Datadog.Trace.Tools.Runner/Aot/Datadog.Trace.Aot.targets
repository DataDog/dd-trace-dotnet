<!--
  Instruments a NativeAOT publish with the Datadog tracer (prototype of the Datadog.Trace.Aot package).

  After ILC computes its inputs, `dd-trace aot instrument` rewrites the application and the assemblies ILC compiles with
  it (framework and packages) with the native tracer hosted offline, and generates the CallTarget registrations and the
  DuckType AOT registry. The rewritten assemblies replace ILC's inputs: nothing under obj/ that a build or a `dotnet run`
  uses changes, and only `dotnet publish -p:PublishAot=true` is affected.

  Properties:
    DatadogAotInstrumentation  false to disable (default: enabled when PublishAot is true)
    DatadogAotRunnerPath       dd-trace runner assembly (Datadog.Trace.Tools.Runner.dll)
    DatadogAotNativeTracerPath Datadog.Tracer.Native library for the build host
    DatadogAotDuckTypeMaps     ducktype-aot map files recorded at runtime (DD_DUCKTYPE_DISCOVERY_OUTPUT_PATH), ';'-separated
    DatadogAotCategories       instrumentation categories (default: tracing,appsec,rasp; add iast to opt in)
    DatadogAotArguments        extra arguments for `dd-trace aot instrument`
    DatadogAotFailOnError      true to fail the publish when the instrumentation fails (default: warning, publish uninstrumented)
-->
<Project>
  <Target Name="DatadogAotInstrument"
          AfterTargets="ComputeIlcCompileInputs"
          BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'$(PublishAot)' == 'true' and '$(DatadogAotInstrumentation)' != 'false'">
    <PropertyGroup>
      <_DatadogAotOutput>$(IntermediateOutputPath)datadog-aot/</_DatadogAotOutput>
      <_DatadogAotRuntimeVersion>$(TargetFrameworkVersion.TrimStart('v')).0</_DatadogAotRuntimeVersion>
      <_DatadogAotCategories>$(DatadogAotCategories)</_DatadogAotCategories>
      <_DatadogAotCategories Condition="'$(_DatadogAotCategories)' == ''">tracing,appsec,rasp</_DatadogAotCategories>
      <_DatadogAotExitCode>-1</_DatadogAotExitCode>
    </PropertyGroup>
    <ItemGroup>
      <_DatadogAotReferenceDirectory Include="@(IlcReference->'%(RootDir)%(Directory)')" />
      <_DatadogAotDatadogTrace Include="@(IlcReference)" Condition="'%(Filename)' == 'Datadog.Trace'" />
      <!-- The application first: its module initializer initializes the instrumentation. -->
      <_DatadogAotAssembly Include="@(IlcCompileInput)" />
      <_DatadogAotAssembly Include="@(IlcReference)" Condition="'%(Filename)' != 'Datadog.Trace' and '%(Filename)' != 'System.Private.CoreLib'" />
      <_DatadogAotDuckTypeMap Include="$(DatadogAotDuckTypeMaps)" />
    </ItemGroup>
    <PropertyGroup>
      <_DatadogAotDatadogTracePath>@(_DatadogAotDatadogTrace->'%(FullPath)')</_DatadogAotDatadogTracePath>
    </PropertyGroup>
    <RemoveDuplicates Inputs="@(_DatadogAotReferenceDirectory)">
      <Output TaskParameter="Filtered" ItemName="_DatadogAotReferenceDirectories" />
    </RemoveDuplicates>

    <Warning Condition="'@(_DatadogAotDatadogTrace)' == ''" Text="Datadog NativeAOT instrumentation skipped: Datadog.Trace.dll isn't an input of the NativeAOT compilation." />
    <Warning Condition="'@(_DatadogAotDatadogTrace)' != '' and ('$(DatadogAotRunnerPath)' == '' or '$(DatadogAotNativeTracerPath)' == '')" Text="Datadog NativeAOT instrumentation skipped: set DatadogAotRunnerPath and DatadogAotNativeTracerPath." />

    <WriteLinesToFile Condition="'@(_DatadogAotDatadogTrace)' != '' and '$(DatadogAotRunnerPath)' != '' and '$(DatadogAotNativeTracerPath)' != ''"
                      File="$(_DatadogAotOutput)arguments.rsp"
                      Lines="--native-tracer=$(DatadogAotNativeTracerPath);--datadog-trace=$(_DatadogAotDatadogTracePath);@(_DatadogAotAssembly->'--assembly=%(FullPath)');@(_DatadogAotReferenceDirectories->'--reference-dir=%(Identity)');--runtime-version=$(_DatadogAotRuntimeVersion);--categories=$(_DatadogAotCategories);@(_DatadogAotDuckTypeMap->'--ducktype-map=%(FullPath)');--report=$(_DatadogAotOutput)report.json;--output=$(_DatadogAotOutput)"
                      Overwrite="true" />
    <Exec Condition="'@(_DatadogAotDatadogTrace)' != '' and '$(DatadogAotRunnerPath)' != '' and '$(DatadogAotNativeTracerPath)' != ''"
          Command="dotnet &quot;$(DatadogAotRunnerPath)&quot; aot instrument @&quot;$(_DatadogAotOutput)arguments.rsp&quot; $(DatadogAotArguments)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_DatadogAotExitCode" />
    </Exec>

    <Error Condition="'$(_DatadogAotExitCode)' != '0' and '$(_DatadogAotExitCode)' != '-1' and '$(DatadogAotFailOnError)' == 'true'" Text="Datadog NativeAOT instrumentation failed (exit code $(_DatadogAotExitCode)): see $(_DatadogAotOutput)report.json." />
    <Warning Condition="'$(_DatadogAotExitCode)' != '0' and '$(_DatadogAotExitCode)' != '-1' and '$(DatadogAotFailOnError)' != 'true'" Text="Datadog NativeAOT instrumentation failed (exit code $(_DatadogAotExitCode)): the application is published without it. See $(_DatadogAotOutput)report.json." />

    <ItemGroup Condition="'$(_DatadogAotExitCode)' == '0'">
      <_DatadogAotInstrumentedInput Include="@(IlcCompileInput)" Condition="Exists('$(_DatadogAotOutput)%(Filename)%(Extension)')" />
      <IlcCompileInput Remove="@(_DatadogAotInstrumentedInput)" />
      <IlcCompileInput Include="@(_DatadogAotInstrumentedInput->'$(_DatadogAotOutput)%(Filename)%(Extension)')" />
      <_DatadogAotInstrumentedReference Include="@(IlcReference)" Condition="Exists('$(_DatadogAotOutput)%(Filename)%(Extension)')" />
      <IlcReference Remove="@(_DatadogAotInstrumentedReference)" />
      <IlcReference Include="@(_DatadogAotInstrumentedReference->'$(_DatadogAotOutput)%(Filename)%(Extension)')" />
      <!-- The DuckType AOT registry the adapters create proxies from, and its trimmer roots. -->
      <IlcReference Include="$(_DatadogAotOutput)Datadog.Trace.DuckType.AotRegistry.*.dll" />
      <TrimmerRootDescriptor Include="$(_DatadogAotOutput)Datadog.Trace.DuckType.AotRegistry.*.linker.xml" />
    </ItemGroup>
    <Message Condition="'$(_DatadogAotExitCode)' == '0'" Importance="high" Text="Datadog NativeAOT instrumentation: @(_DatadogAotInstrumentedInput->'%(Filename)');@(_DatadogAotInstrumentedReference->'%(Filename)')" />
  </Target>
</Project>
