<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Always ship this package as a prerelease so it stays out of default NuGet listings, but keep
      the version number so it can still be associated with the rest of the release. A dev build's
      version is already a semver prerelease, so it needs no further suffix - and appending one
      would produce the nonsense 3.56.0-dev.gX-prerelease.
    -->
    <Version Condition="'$(DD_VersionSuffix)' == ''">$(DD_VersionPrefix)-prerelease</Version>
    <Version Condition="'$(DD_VersionSuffix)' != ''">$(DD_SemVer)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.1</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoRestore>true</NoRestore>
    <PublishBuildOutput>false</PublishBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuspecFile>Datadog.Trace.Trimming.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <NoWarn>NU5128</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <Content Include="..\..\..\datadog-logo-256x256.png" Link="datadog-logo-256x256.png" />
  </ItemGroup>

</Project>