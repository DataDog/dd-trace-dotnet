# EditorConfig is awesome:http://EditorConfig.org

[*.{cs,vb}]
dotnet_diagnostic.CA2007.severity=error # Consider calling ConfigureAwait on the awaited task

# Meziantou.Analyzer
# MeziantouAnalysisMode=all-errors (see tracer/src/Directory.Build.props) makes every MA rule an error by default.
# The rules below are explicitly disabled. Rules that aren't listed here are enforced as errors.

# ---------------------------------------------------------------------------------------------------
# Rules we don't want
# ---------------------------------------------------------------------------------------------------

# Style preferences that add churn without any correctness benefit
dotnet_diagnostic.MA0071.severity = none # Avoid using redundant else
dotnet_diagnostic.MA0073.severity = none # Avoid comparison with bool constant
dotnet_diagnostic.MA0148.severity = none # Use 'is' patterns instead of '==' for constant values
dotnet_diagnostic.MA0149.severity = none # Use 'is not' patterns instead of '!=' for constant values
dotnet_diagnostic.MA0171.severity = none # Use 'is null' / 'is not null' instead of Nullable<T>.HasValue
dotnet_diagnostic.MA0174.severity = none # Record should use explicit 'class' keyword
dotnet_diagnostic.MA0206.severity = none # Remove unnecessary braces in type declaration
dotnet_diagnostic.MA0181.severity = none # Do not use cast
dotnet_diagnostic.MA0191.severity = none # Do not use the null-forgiving operator
dotnet_diagnostic.MA0109.severity = none # Consider adding an overload with a Span<T> or Memory<T>

# Contradictory pairs of style rules, choosing between them is a case-by-case decision
dotnet_diagnostic.MA0177.severity = none # Use single-line XML comment syntax when possible
dotnet_diagnostic.MA0211.severity = none # Use multi-line syntax for XML summary comments
dotnet_diagnostic.MA0214.severity = none # Use 'await' instead of returning the task
dotnet_diagnostic.MA0215.severity = none # Return the task instead of awaiting it

# XML documentation style
dotnet_diagnostic.MA0154.severity = none # Use langword in XML comment
dotnet_diagnostic.MA0219.severity = none # Set the language attribute in XML comment

# Arbitrary thresholds and markers
dotnet_diagnostic.MA0051.severity = none # Method is too long
dotnet_diagnostic.MA0026.severity = none # Fix TODO comment

# Conflicts with existing StyleCop choices: SA1402/SA1649 already enforce our file/type naming convention, which allows small related types in the same file
dotnet_diagnostic.MA0048.severity = none # File name must match type name

# The default behaviour is already ordinal: string ==, string.Equals(string), Dictionary<string,T>, HashSet<string>, and string.GetHashCode() are all ordinal, so specifying a comparer changes nothing, and can even degrade performance in some cases. Culture-sensitive comparisons are covered by MA0074
dotnet_diagnostic.MA0001.severity = none # StringComparison is missing
dotnet_diagnostic.MA0002.severity = none # IEqualityComparer<string> or IComparer<string> is missing
dotnet_diagnostic.MA0006.severity = none # Use String.Equals instead of equality operator
dotnet_diagnostic.MA0021.severity = none # Use StringComparer.GetHashCode instead of string.GetHashCode
dotnet_diagnostic.MA0127.severity = none # Use String.Equals instead of is pattern

# Async-suffix naming rules: MA0156/MA0157 contradict each other, and the others conflict with duck typing and CallTarget, where method names mirror the instrumented third-party methods
dotnet_diagnostic.MA0137.severity = none # Use 'Async' suffix when a method returns an awaitable type
dotnet_diagnostic.MA0138.severity = none # Do not use 'Async' suffix when a method does not return an awaitable type
dotnet_diagnostic.MA0156.severity = none # Use 'Async' suffix when a method returns IAsyncEnumerable<T>
dotnet_diagnostic.MA0157.severity = none # Do not use 'Async' suffix when a method returns IAsyncEnumerable<T>

# CallTarget integrations are used as generic type arguments, so they can't be static classes
dotnet_diagnostic.MA0036.severity = none # Make class static

# Types are frequently only referenced via reflection, duck typing, CallTarget or source generators
dotnet_diagnostic.MA0182.severity = none # Avoid unused internal types

# Deprecated by Meziantou in favour of CA rules (CA1822, CA1000). We rely on static members of generic types for caches
dotnet_diagnostic.MA0018.severity = none # Do not declare static members on generic types (deprecated; use CA1000 instead)
dotnet_diagnostic.MA0038.severity = none # Make method static (deprecated, use CA1822 instead)
dotnet_diagnostic.MA0041.severity = none # Make property static (deprecated, use CA1822 instead)

# Exposing concrete collection types avoids interface dispatch and enumerator boxing on hot paths
dotnet_diagnostic.MA0016.severity = none # Prefer using collection abstraction instead of implementation

# Many of our APIs and instrumentation callbacks are synchronous and can't become async
dotnet_diagnostic.MA0045.severity = none # Do not use blocking calls, even when the calling method must become async

# Passing CancellationToken.None everywhere adds noise without benefit
dotnet_diagnostic.MA0032.severity = none # Use an overload with a CancellationToken argument, even when no token is available in scope

# Calling ToString() on object-typed values (e.g. tag values) is intentional
dotnet_diagnostic.MA0107.severity = none # Do not use object.ToString

# partial is required for types split across TFM-specific files
dotnet_diagnostic.MA0204.severity = none # Remove unnecessary partial modifier


# Enum.HasFlag boxes on .NET Framework, so bitwise checks are preferred
dotnet_diagnostic.MA0192.severity = none # Use HasFlag instead of bitwise checks

# Explicit enum members aren't always available, e.g. in duck-typed enums mirroring third-party types
dotnet_diagnostic.MA0099.severity = none # Use Explicit enum value instead of 0

# Structs already use sequential layout by default
dotnet_diagnostic.MA0008.severity = none # Add StructLayoutAttribute

# We use Action-based events internally to avoid allocating EventArgs
dotnet_diagnostic.MA0046.severity = none # Use EventHandler<T> to declare events

# The suggested APIs aren't available on all of our target frameworks (net461, netstandard2.0, netcoreapp3.1)
dotnet_diagnostic.MA0110.severity = none # Use the Regex source generator
dotnet_diagnostic.MA0111.severity = none # Use string.Create instead of FormattableString
dotnet_diagnostic.MA0144.severity = none # Use System.OperatingSystem to check the current OS
dotnet_diagnostic.MA0158.severity = none # Use System.Threading.Lock
dotnet_diagnostic.MA0188.severity = none # Use System.TimeProvider instead of a custom time abstraction
dotnet_diagnostic.MA0189.severity = none # Use InlineArray instead of fixed-size buffers

# ---------------------------------------------------------------------------------------------------
# Rules we want, but which currently have violations.
# These are temporarily disabled, and will be fixed and enabled in subsequent PRs.
# ---------------------------------------------------------------------------------------------------
dotnet_diagnostic.MA0003.severity = none # Add parameter name to improve readability - ~940 null/bool literal arguments across ~350 files. Mechanical (code fix available in the IDE), but a large diff
dotnet_diagnostic.MA0005.severity = none # Use Array.Empty<T>()
dotnet_diagnostic.MA0007.severity = none # Add a comma after the last value - StyleCop SA1413 (suppressed in tracer/GlobalSuppressions.cs) should be re-enabled at the same time. Trailing commas simplify merge conflicts
dotnet_diagnostic.MA0009.severity = none # Add regex evaluation timeout
dotnet_diagnostic.MA0010.severity = none # Mark attributes with AttributeUsageAttribute
dotnet_diagnostic.MA0012.severity = none # Do not raise reserved exception type
dotnet_diagnostic.MA0015.severity = none # Specify the parameter name in ArgumentException
dotnet_diagnostic.MA0017.severity = none # Abstract types should not have public or internal constructors
dotnet_diagnostic.MA0020.severity = none # Use direct methods instead of LINQ methods
dotnet_diagnostic.MA0023.severity = none # Use RegexOptions.ExplicitCapture or named groups
dotnet_diagnostic.MA0025.severity = none # Implement the functionality instead of throwing NotImplementedException
dotnet_diagnostic.MA0028.severity = none # Optimize StringBuilder usage
dotnet_diagnostic.MA0029.severity = none # Combine LINQ methods
dotnet_diagnostic.MA0031.severity = none # Optimize Enumerable.Count() usage
dotnet_diagnostic.MA0040.severity = none # Forward the CancellationToken parameter to methods that take one - skipped: the in-scope tokens are mostly the wrong ones to forward (per-request timeouts, RequestAborted), and the rest would only add an explicit CancellationToken.None
dotnet_diagnostic.MA0042.severity = none # Do not use blocking calls when the calling method is async - skipped: most hits are Newtonsoft JsonWriter calls on in-memory buffers (async variants only add overhead), await using/DisposeAsync needs #if (IAsyncDisposable is .NET Core-only), and the .Result hits read completed tasks in CallTarget continuations
dotnet_diagnostic.MA0043.severity = none # Use nameof operator in ArgumentException
dotnet_diagnostic.MA0044.severity = none # Remove useless ToString call
dotnet_diagnostic.MA0047.severity = none # Declare types in namespaces
dotnet_diagnostic.MA0049.severity = none # Type name should not match containing namespace
dotnet_diagnostic.MA0052.severity = none # Replace constant Enum.ToString with nameof
dotnet_diagnostic.MA0053.severity = none # Make class or record sealed
dotnet_diagnostic.MA0055.severity = none # Do not use finalizer - existing native-resource finalizers should get justified suppressions (or move to SafeHandle). ~Tracer only maintains a live-instance count, so should be justified or removed
dotnet_diagnostic.MA0057.severity = none # Class name should end with 'Attribute'
dotnet_diagnostic.MA0058.severity = none # Class name should end with 'Exception'
dotnet_diagnostic.MA0061.severity = none # Method overrides should not change default values
dotnet_diagnostic.MA0062.severity = none # Non-flags enums should not be marked with "FlagsAttribute"
dotnet_diagnostic.MA0065.severity = none # Default ValueType.Equals or HashCode is used for struct equality
dotnet_diagnostic.MA0066.severity = none # Hash table unfriendly type is used in a hash table
dotnet_diagnostic.MA0070.severity = none # Obsolete attributes should include explanations
dotnet_diagnostic.MA0077.severity = none # A class that provides Equals(T) should implement IEquatable<T>
dotnet_diagnostic.MA0084.severity = none # Local variables should not hide other symbols
dotnet_diagnostic.MA0089.severity = none # Optimize string method usage - some suggested overloads (e.g. char overloads) aren't available on net461/netstandard2.0, so may require polyfills
dotnet_diagnostic.MA0096.severity = none # A class that implements IComparable<T> should also implement IEquatable<T>
dotnet_diagnostic.MA0097.severity = none # A class that implements IComparable<T> or IComparable should override comparison operators
dotnet_diagnostic.MA0098.severity = none # Use indexer instead of LINQ methods
dotnet_diagnostic.MA0101.severity = none # String contains an implicit end of line character
dotnet_diagnostic.MA0102.severity = none # Make member readonly
dotnet_diagnostic.MA0104.severity = none # Do not create a type with a name from the BCL
dotnet_diagnostic.MA0105.severity = none # Use the lambda parameters instead of using a closure
dotnet_diagnostic.MA0106.severity = none # Avoid closure by using an overload with the 'factoryArgument' parameter
dotnet_diagnostic.MA0128.severity = none # Use 'is' operator instead of SequenceEqual
dotnet_diagnostic.MA0136.severity = none # Raw String contains an implicit end of line character
dotnet_diagnostic.MA0141.severity = none # Use 'is not null' instead of '!= null'
dotnet_diagnostic.MA0142.severity = none # Use 'is null' instead of '== null'
dotnet_diagnostic.MA0150.severity = none # Do not call ToString() when the type falls back to object.ToString()
dotnet_diagnostic.MA0159.severity = none # Use 'Order' instead of 'OrderBy'
dotnet_diagnostic.MA0160.severity = none # Use ContainsKey instead of TryGetValue
dotnet_diagnostic.MA0161.severity = none # UseShellExecute must be explicitly set
dotnet_diagnostic.MA0168.severity = none # Use readonly struct for in or ref readonly parameter - drop `in` for small/BCL/Nullable types, make our structs readonly where possible, and suppress where `in` is required (P/Invoke, IAST aspect signatures)
dotnet_diagnostic.MA0176.severity = none # Optimize guid creation
dotnet_diagnostic.MA0179.severity = none # Use Attribute.IsDefined instead of GetCustomAttribute(s)
dotnet_diagnostic.MA0184.severity = none # Do not use interpolated string without parameters
dotnet_diagnostic.MA0186.severity = none # Equals method should use [NotNullWhen(true)] on the parameter
dotnet_diagnostic.MA0193.severity = none # Use an overload with a MidpointRounding argument
dotnet_diagnostic.MA0194.severity = none # Merge is expressions on the same value
dotnet_diagnostic.MA0197.severity = none # Add dedicated documentation on types
dotnet_diagnostic.MA0200.severity = none # Do not use empty property patterns with non-nullable value types
dotnet_diagnostic.MA0209.severity = none # Use in keyword for in parameter
dotnet_diagnostic.MA0217.severity = none # Use a static lambda
dotnet_diagnostic.MA0221.severity = none # TryGetValue method should use [MaybeNullWhen(false)] on the value parameter
dotnet_diagnostic.MA0239.severity = none # Use 'typeof' instead of 'GetType()' when the type is sealed
dotnet_diagnostic.MA0242.severity = none # Use a value factory to compute the value only when the key is not in the ConcurrentDictionary
