<linker>
  <!-- NativeAOT applications without the ASP.NET Core assemblies: the Datadog.Trace.Aot targets set the feature switch, so ILC
       leaves out the code that uses them (see AspNetCoreAvailabilityChecker.IsSupported). -->
  <assembly fullname="Datadog.Trace">
    <type fullname="Datadog.Trace.AspNetCoreAvailabilityChecker" feature="Datadog.Trace.AspNetCore.IsSupported" featurevalue="false">
      <method signature="System.Boolean get_IsSupported()" body="stub" value="false" />
    </type>
    <!-- Without dynamic code (NativeAOT, which sets the feature switch): these properties return
         RuntimeFeature.IsDynamicCodeSupported, a constant ILC 9+ propagates through them but ILC 8 doesn't. -->
    <type fullname="Datadog.Trace.DuckTyping.DuckTypeAotEngine" feature="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" featurevalue="false">
      <method signature="System.Boolean get_IsDynamicCodeSupported()" body="stub" value="false" />
    </type>
    <type fullname="Datadog.Trace.Debugger.DebuggerManager" feature="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" featurevalue="false">
      <method signature="System.Boolean get_RuntimeDebuggerProductsSupported()" body="stub" value="false" />
    </type>
    <type fullname="Datadog.Trace.ClrProfiler.CallTarget.Handlers.IntegrationMapper" feature="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" featurevalue="false">
      <method signature="System.Boolean get_IsSupported()" body="stub" value="false" />
    </type>
  </assembly>
</linker>
