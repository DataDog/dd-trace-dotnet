<Project>

  <!--
    Injected into BenchmarkDotNet's generated bootstrap projects via the CustomAfterMicrosoftCommonTargets
    MSBuild hook. BenchmarkDotNet sets ImportDirectoryBuildProps/Targets=false on the projects it
    generates, so Directory.Build.targets is not an option.

    BenchmarkDotNet generates a bootstrap project for every (benchmark class x runtime) pair, with a
    ProjectReference back to the benchmark project, and builds it with /p:ArtifactsPath pointing at a
    fresh per-job folder. ArtifactsPath is a global property so it applies to the whole project graph,
    which defeats incremental reuse of the BuildTracerHome/BuildBenchmarks output: MSBuild recompiles
    the entire tracer closure (~58s) for every job. In CI that is 3 runtimes x 20 parallel items,
    roughly 60 redundant full builds of the tracer, all at once.

    BuildBenchmarks has already built the benchmark project for every target framework, so point the
    bootstrap project at those binaries instead of rebuilding from source. Only applied if
    BdnPrebuiltBinRoot is set, so ordinary builds are unaffected.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">
    <_BdnBootstrapImported>true</_BdnBootstrapImported>
    <_BdnPrebuiltDir Condition="'$(BdnPrebuiltBinRoot)' != ''">$(BdnPrebuiltBinRoot)\$(Configuration.ToLowerInvariant())_$(TargetFramework)</_BdnPrebuiltDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(_BdnPrebuiltDir)' != '' AND Exists('$(_BdnPrebuiltDir)')">
    <ProjectReference Remove="@(ProjectReference)" />
    <Reference Include="$(_BdnPrebuiltDir)\*.dll">
      <Private>true</Private>
    </Reference>
    <!-- On .NET Framework the benchmark assembly is an .exe rather than a .dll. Not globbed for
         .NET (Core) targets, where the .exe is a native apphost with no managed metadata. -->
    <Reference Include="$(_BdnPrebuiltDir)\*.exe" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    Without this, every way the rule can fail to apply is silent: Microsoft.Common.targets imports
    CustomAfterMicrosoftCommonTargets only under Exists(), so a bad path is skipped without a word, and
    a missing prebuilt directory would just quietly build from source. A run that did not apply the rule
    would then be indistinguishable from one that did, which makes it impossible to tell whether an
    experiment actually tested anything.

    BenchmarkDotNet only echoes the build output when a build fails, so these messages surface exactly
    when they are needed. On a successful run, use the per-build durations (seconds rather than ~a
    minute) and the post-run check in run-benchmarks.ps1 instead.
  -->
  <Target Name="ReportBenchmarkBootstrap" BeforeTargets="PrepareForBuild" Condition="'$(_BdnBootstrapImported)' == 'true'">
    <Message Importance="high" Condition="'$(BdnPrebuiltBinRoot)' == ''"
             Text="[BenchmarkBootstrap] Imported, but BdnPrebuiltBinRoot is not set: building the benchmark project from source." />
    <Error Condition="'$(BdnPrebuiltBinRoot)' != '' AND !Exists('$(_BdnPrebuiltDir)')"
           Text="[BenchmarkBootstrap] BdnPrebuiltBinRoot is set but there is no prebuilt output at '$(_BdnPrebuiltDir)'. Run BuildBenchmarks first, or clear BdnPrebuiltBinRoot to build from source." />
    <Message Importance="high" Condition="Exists('$(_BdnPrebuiltDir)')"
             Text="[BenchmarkBootstrap] Using prebuilt binaries from '$(_BdnPrebuiltDir)'. ProjectReference count is now @(ProjectReference->Count())." />
  </Target>

</Project>
