<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApiVersion Condition="'$(ApiVersion)' == ''">1.19.0</ApiVersion>
    <!-- Azure Managed 1.9.0 requires the host dependencies included with DurableTask 1.16.5 or later. -->
    <AzureManagedVersion Condition="$(ApiVersion) &lt; 1.16.5">1.5.0</AzureManagedVersion>
    <AzureManagedVersion Condition="'$(AzureManagedVersion)' == ''">1.9.0</AzureManagedVersion>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" Version="$(ApiVersion)" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask.AzureManaged" Version="$(AzureManagedVersion)" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.2" />
  </ItemGroup>

  <!-- Core Tools loads WebJobs extensions from .azurefunctions, so the generated WorkerExtensions project
       must carry its net8 Microsoft.Extensions.* dependencies. -->
  <Target Name="SetAzureFunctionsWorkerExtensionBuildProperties" BeforeTargets="_FunctionsPreBuild">
    <PropertyGroup>
      <_FunctionsExtensionCommonProps>$(_FunctionsExtensionCommonProps);DisableTransitiveFrameworkReferences=true</_FunctionsExtensionCommonProps>
    </PropertyGroup>
  </Target>

  <Target Name="CopyAzureFunctionsWorkerExtensionConfigurationAssemblies" AfterTargets="_FunctionsExtensionAssignTargetPaths">
    <ItemGroup>
      <_AzureFunctionsWorkerExtensionConfigurationAssembly Include="$(_FunctionsExtensionsOutputPath)\Microsoft.Extensions.Configuration.dll" />
      <_AzureFunctionsWorkerExtensionConfigurationAssembly Include="$(_FunctionsExtensionsOutputPath)\Microsoft.Extensions.Configuration.Abstractions.dll" />
      <_AzureFunctionsWorkerExtensionConfigurationAssembly Include="$(_FunctionsExtensionsOutputPath)\Microsoft.Extensions.Configuration.Binder.dll" />
      <_AzureFunctionsWorkerExtensionConfigurationAssembly Include="$(_FunctionsExtensionsOutputPath)\Microsoft.Extensions.Primitives.dll" />
      <_NoneWithTargetPath
        Include="@(_AzureFunctionsWorkerExtensionConfigurationAssembly)"
        TargetPath="$(_FunctionsExtensionsDirectory)/%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Error
      Condition="!Exists('%(_AzureFunctionsWorkerExtensionConfigurationAssembly.Identity)')"
      Text="Missing Azure Functions worker extension dependency: %(_AzureFunctionsWorkerExtensionConfigurationAssembly.Identity)" />
  </Target>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Threading.ExecutionContext" Alias="ExecutionContext" />
  </ItemGroup>
</Project>
