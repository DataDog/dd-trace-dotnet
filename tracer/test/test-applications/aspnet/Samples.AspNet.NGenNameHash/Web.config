<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <handlers>
      <add name="NGenNameHashHandler" verb="*" path="*" type="Samples.AspNet.NGenNameHash.HttpHandler, Samples.AspNet.NGenNameHash" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
