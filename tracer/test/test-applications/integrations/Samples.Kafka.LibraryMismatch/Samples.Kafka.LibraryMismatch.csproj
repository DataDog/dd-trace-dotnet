<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresDockerDependency>All</RequiresDockerDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.8.0" />
    <!-- Acquire the old native assets without downgrading the managed client's dependency. -->
    <PackageDownload Include="librdkafka.redist" Version="[1.6.1];[2.2.0]" />
  </ItemGroup>

  <!-- CI builds samples on Windows and shares their output with Linux jobs, so copy both platforms' assets. -->
  <Target Name="CopyOldLibrdkafka" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <!-- These Linux variants avoid dependencies on old system OpenSSL/SASL libraries. -->
      <OldLibrdkafka Include="$(NuGetPackageRoot)librdkafka.redist/1.6.1/runtimes/win-x64/native/*.dll;
                             $(NuGetPackageRoot)librdkafka.redist/1.6.1/runtimes/linux-x64/native/centos6-librdkafka.so;
                             $(NuGetPackageRoot)librdkafka.redist/1.6.1/runtimes/linux-x64/native/alpine-librdkafka.so">
        <NativeVersion>1.6.1</NativeVersion>
      </OldLibrdkafka>
      <OldLibrdkafka Include="$(NuGetPackageRoot)librdkafka.redist/2.2.0/runtimes/win-x64/native/*.dll;
                             $(NuGetPackageRoot)librdkafka.redist/2.2.0/runtimes/linux-x64/native/centos6-librdkafka.so;
                             $(NuGetPackageRoot)librdkafka.redist/2.2.0/runtimes/linux-x64/native/alpine-librdkafka.so">
        <NativeVersion>2.2.0</NativeVersion>
      </OldLibrdkafka>
    </ItemGroup>
    <Copy SourceFiles="@(OldLibrdkafka)" DestinationFolder="$(TargetDir)librdkafka-%(OldLibrdkafka.NativeVersion)" SkipUnchangedFiles="true" />
  </Target>
</Project>
