      "rawPattern": "^[\\\\d]$",
      "normalizedPattern": "^[\\\\d]$",
      "expectedCompile": true,
      "input": "d",
      "expectedMatch": true
    },
    {
      "id": "accepted-escaped-boundary-in-character-class",
      "description": "A doubled backslash before b inside a character class is literal syntax, not a word boundary.",
      "category": "character-class",
      "contract": "accepted",
      "rawPattern": "^[\\\\b]$",
