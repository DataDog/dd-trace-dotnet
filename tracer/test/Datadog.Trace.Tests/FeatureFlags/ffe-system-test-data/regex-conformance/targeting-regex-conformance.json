    },
    {
      "id": "rejected-rust-character-class-intersection-after-leading-closing-bracket-in-negated-class",
      "description": "A leading closing bracket after negation stays inside the class; Rust complements an empty intersection while Go and RE2JS treat ampersands as excluded literals.",
      "category": "character-class-dialect",
      "contract": "rejected",
      "rawPattern": "^[^]a&&b]+$",
      "normalizedPattern": "^[^]a&&b]+$",
      "expectedCompile": true,
      "input": "&",
