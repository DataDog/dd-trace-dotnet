{
  "$id": "precomputed-assignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLEX Precomputed Assignment Fixture",
  "description": "Schema for precomputed assignment test fixtures consumed by client SDKs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "context",
    "response",
    "evaluations",
    "expectations"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Fixture identifier; should match the filename stem."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what the fixture tests."
    },
    "context": {
      "$ref": "#/$defs/EvaluationContext"
    },
    "response": {
      "type": "object",
      "description": "Mocked precomputed-assignments response. Legacy assignments remain in attributes.flags; capable-client failures use attributes.flagEvaluationErrors.",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "attributes": {
              "type": "object",
              "properties": {
                "flags": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/FlagAssignment"
                  }
                },
                "flagEvaluationErrors": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/FlagEvaluationError"
                  }
                }
              }
            }
          }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evaluation"
      }
    },
    "expectations": {
      "$ref": "#/$defs/Expectations"
    },
    "_skip": {
      "$ref": "#/$defs/PlatformFilter",
      "description": "Skip this entire fixture for listed platforms."
    },
    "_include": {
      "$ref": "#/$defs/PlatformFilter",
      "description": "Run this fixture only for listed platforms."
    },
    "expectedResponseError": {
      "const": "INVALID_RESPONSE",
      "description": "Reject the complete response before installation; run no evaluations and emit no events."
    }
  },
  "not": {
    "required": [
      "_skip",
      "_include"
    ]
  },
  "$defs": {
    "FlagAssignment": {
      "type": "object",
      "properties": {
        "dependencyEvaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEvaluation"
          }
        }
      },
      "additionalProperties": true
    },
    "FlagEvaluationError": {
      "type": "object",
      "required": [
        "reason",
        "errorCode"
      ],
      "properties": {
        "reason": {
          "const": "ERROR"
        },
        "errorCode": {
          "const": "GENERAL"
        },
        "errorMessage": {
          "type": "string",
          "minLength": 1
        },
        "dependencyEvaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEvaluation"
          }
        }
      },
      "additionalProperties": true
    },
    "DependencyEvaluation": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuccessfulDependencyEvaluation"
        },
        {
          "$ref": "#/$defs/FailedDependencyEvaluation"
        }
      ]
    },
    "SuccessfulDependencyEvaluation": {
      "type": "object",
      "required": [
        "flagKey",
        "isPresentInAssignment"
      ],
      "properties": {
        "flagKey": {
          "type": "string",
          "minLength": 1
        },
        "isPresentInAssignment": {
          "type": "boolean"
        }
      },
      "not": {
        "anyOf": [
          { "required": ["reason"] },
          { "required": ["errorCode"] },
          { "required": ["errorMessage"] }
        ]
      },
      "additionalProperties": true
    },
    "FailedDependencyEvaluation": {
      "type": "object",
      "required": [
        "flagKey",
        "reason",
        "errorCode"
      ],
      "properties": {
        "flagKey": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "const": "ERROR"
        },
        "errorCode": {
          "type": "string",
          "minLength": 1
        },
        "errorMessage": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": ["isPresentInAssignment"]
      },
      "additionalProperties": true
    },
    "PlatformFilterEntry": {
      "type": "object",
      "required": [
        "platform"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "description": "Platform identifier (e.g., web, ios, android, flutter, react-native, maui, kotlin-multiplatform, electron).",
          "enum": [
            "web",
            "ios",
            "android",
            "react-native",
            "flutter",
            "unity",
            "maui",
            "kotlin-multiplatform",
            "electron"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Optional explanation for why this platform is skipped or included."
        }
      }
    },
    "PlatformFilter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlatformFilterEntry"
      },
      "minItems": 1
    },
    "EvaluationContext": {
      "type": "object",
      "required": [
        "targetingKey",
        "attributes"
      ],
      "additionalProperties": false,
      "properties": {
        "targetingKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "ExpectedResult": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Expected flag value; must match the evaluation variationType."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expected OpenFeature reason code."
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expected OpenFeature error code."
        },
        "variantKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expected variation key."
        }
      }
    },
    "Evaluation": {
      "type": "object",
      "required": [
        "flag",
        "variationType",
        "defaultValue",
        "expectedResult"
      ],
      "additionalProperties": false,
      "properties": {
        "flag": {
          "type": "string",
          "description": "Flag key to evaluate."
        },
        "variationType": {
          "type": "string",
          "enum": [
            "boolean",
            "string",
            "integer",
            "float",
            "object"
          ],
          "description": "Type to request from the SDK getter."
        },
        "defaultValue": {
          "description": "Default value passed to the getter; must match variationType."
        },
        "expectedResult": {
          "$ref": "#/$defs/ExpectedResult"
        },
        "_skip": {
          "$ref": "#/$defs/PlatformFilter"
        },
        "_include": {
          "$ref": "#/$defs/PlatformFilter"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "boolean"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "boolean"
              },
              "expectedResult": {
                "properties": {
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "string"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "string"
              },
              "expectedResult": {
                "properties": {
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "integer"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "integer"
              },
              "expectedResult": {
                "properties": {
                  "value": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "float"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "number"
              },
              "expectedResult": {
                "properties": {
                  "value": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "object"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "object"
              },
              "expectedResult": {
                "properties": {
                  "value": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      ],
      "not": {
        "required": [
          "_skip",
          "_include"
        ]
      }
    },
    "EventMatcher": {
      "type": "object",
      "required": [
        "_count"
      ],
      "description": "Matches received events by subset. All keys not prefixed with _ are match fields compared against event data. Control fields: _count (required), _skip, _include.",
      "properties": {
        "_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of events this matcher should consume."
        },
        "_skip": {
          "$ref": "#/$defs/PlatformFilter"
        },
        "_include": {
          "$ref": "#/$defs/PlatformFilter"
        }
      },
      "not": {
        "required": [
          "_skip",
          "_include"
        ]
      }
    },
    "Expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noUnmatchedEvents": {
          "type": "boolean",
          "default": false,
          "description": "When true, assert that all received events (exposures and evaluations) are consumed by matchers. No extra events allowed."
        },
        "orderedEvents": {
          "type": "boolean",
          "default": false,
          "description": "When true, assert that exposure and evaluation events are emitted in the order declared by their matcher lists."
        },
        "exposures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventMatcher"
          },
          "description": "Ordered, exclusive matchers for exposure events."
        },
        "evaluationEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventMatcher"
          },
          "description": "Ordered, exclusive matchers for flagevaluation events."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "expectedResponseError"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "maxItems": 0
          },
          "expectations": {
            "required": [
              "noUnmatchedEvents"
            ],
            "properties": {
              "noUnmatchedEvents": {
                "const": true
              },
              "exposures": {
                "maxItems": 0
              },
              "evaluationEvents": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evaluations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
