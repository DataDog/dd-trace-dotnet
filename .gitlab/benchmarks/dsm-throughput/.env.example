DD_API_KEY=INSERT_YOUR_API_KEY_HERE

# Choose configuration variables 
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_APPSEC=false

# Choose k6 options for the load tests
K6_OPTIONS_NORMAL_OPERATION_DURATION=1m
K6_OPTIONS_HIGH_LOAD_DURATION=1m
