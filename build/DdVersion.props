<Project>

  <!--
    The SDK version for native (.vcxproj) projects: they import this file instead of version.props,
    which managed projects import directly. It is the MSBuild equivalent of build/cmake/DdVersion.cmake.

    As well as the properties from <repo-root>/version.props, it adds the DD_VERSION_* preprocessor
    definitions that shared/src/native-src/dd_version.h expects - the same set that DdVersion.cmake
    defines. The *_PART_VERSION values are deliberately bare tokens (1.2.3, not "1.2.3"):
    ResourceCompile passes quoted values to rc.exe as empty strings, and escaping the quotes breaks
    cl.exe instead.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\version.props" />

  <PropertyGroup>
    <DD_NativeVersionDefinitions>DD_VERSION_MAJOR=$([System.Version]::Parse('$(DD_VersionPrefix)').Major);DD_VERSION_MINOR=$([System.Version]::Parse('$(DD_VersionPrefix)').Minor);DD_VERSION_PATCH=$([System.Version]::Parse('$(DD_VersionPrefix)').Build)</DD_NativeVersionDefinitions>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>$(DD_NativeVersionDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>$(DD_NativeVersionDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

</Project>
