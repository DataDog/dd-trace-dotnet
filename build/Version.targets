<Project>

  <!--
    The single generator for shared/src/native-src/dd_version.g.h.

    The values it writes come from build/Version.props, which in turn picks up the resolved build
    channel / dev token from artifacts/version/Version.g.props when the Nuke build has produced
    one. Keeping the *writing* here and the *resolving* in Nuke means there is exactly one place
    that knows the header's format.

    The target is hooked into every project that compiles, so an IDE or bare `dotnet build` works
    on a fresh clone. The Nuke `GenerateVersionFiles` target runs it once up front, which matters
    for two reasons: CMake needs the header to exist before it configures, and it means the
    parallel C++ fan-out in tracer/Datadog.Trace.proj finds the content already correct, so
    WriteOnlyWhenDifferent turns every subsequent invocation into a read with no write to race on.

    One item per output line. MSBuild rejects an empty Include, so comment lines are used as
    separators instead of blank lines.
  -->

  <Target Name="DD_GenerateVersionFiles"
          BeforeTargets="BeforeBuild;BeforeClCompile;BeforeResourceCompile;CoreCompile"
          Condition="'$(DD_VersionPrefix)' != ''">

    <ItemGroup>
      <DD_VersionHeaderLine Include="#ifndef DD_VERSION_G_H" />
      <DD_VersionHeaderLine Include="#define DD_VERSION_G_H" />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="// &lt;auto-generated/&gt; Generated from version.props by build/Version.targets." />
      <DD_VersionHeaderLine Include="// Do not edit, and do not commit - this file is gitignored." />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="// Deliberately #define-only, with classic include guards rather than constexpr and" />
      <DD_VersionHeaderLine Include="// #pragma once: the Windows resource compiler (rc.exe) preprocesses this file too, and" />
      <DD_VersionHeaderLine Include="// understands neither." />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="// DD_SEMVER_STR and DD_VERSION_REVISION change whenever HEAD moves, so every translation" />
      <DD_VersionHeaderLine Include="// unit that includes this header is recompiled on a commit, amend, checkout or rebase." />
      <DD_VersionHeaderLine Include="// That is currently ~14 of 58 TUs in the native tracer, 3 of 93 in the profiler and 1 of" />
      <DD_VersionHeaderLine Include="// 10 in the native loader, which we accept. If it ever becomes painful, move those two" />
      <DD_VersionHeaderLine Include="// macros into a separate header included only by a single .cpp plus the .rc files. If" />
      <DD_VersionHeaderLine Include="// native compile caching is ever introduced, exclude this file from the cache key." />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="// Numeric shapes. These never carry the -dev suffix: Win32 FILEVERSION fields are four" />
      <DD_VersionHeaderLine Include="// 16-bit integers, AssemblyProperty::WithVersion takes four USHORTs, and the managed" />
      <DD_VersionHeaderLine Include="// assembly identity has to stay a well-formed four-part version." />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="#define DD_VERSION_MAJOR $(DD_VersionPrefix.Split('.')[0])" />
      <DD_VersionHeaderLine Include="#define DD_VERSION_MINOR $(DD_VersionPrefix.Split('.')[1])" />
      <DD_VersionHeaderLine Include="#define DD_VERSION_PATCH $(DD_VersionPrefix.Split('.')[2])" />
      <DD_VersionHeaderLine Include="#define DD_VERSION_REVISION $(DD_VersionRevision)" />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="#define DD_THREE_PART_VERSION_STR &quot;$(DD_ThreePartVersion)&quot;" />
      <DD_VersionHeaderLine Include="#define DD_FOUR_PART_VERSION_STR &quot;$(DD_FourPartVersion)&quot;" />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="// The full semantic version, e.g. 3.56.0 or 3.56.0-dev.g1a2b3c4d. This is the one that" />
      <DD_VersionHeaderLine Include="// identifies a specific build, and the only one that may contain a suffix." />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="#define DD_SEMVER_STR &quot;$(DD_SemVer)&quot;" />
      <DD_VersionHeaderLine Include="//" />
      <DD_VersionHeaderLine Include="#endif // DD_VERSION_G_H" />
    </ItemGroup>

    <WriteLinesToFile File="$(DD_GeneratedVersionHeader)"
                      Lines="@(DD_VersionHeaderLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <!-- Don't leak the lines into any other target that runs in the same project. -->
      <DD_VersionHeaderLine Remove="@(DD_VersionHeaderLine)" />
    </ItemGroup>
  </Target>

  <!--
    Generates the managed version constants that used to be committed literals kept in sync by the
    version-bump tooling.

    A project opts in by setting DD_GenerateVersionSource to the name of the template it wants.
    Three projects compile TracerConstants.cs (Datadog.Trace, the dd-dotnet tool and the tool's
    integration tests), so this lives here rather than in tracer/src/Directory.Build.targets - it
    has to reach tracer/test as well.

    The file goes into $(IntermediateOutputPath), which this repo redirects to
    artifacts/obj/<Project>/<config>_<tfm>/ (see UseArtifactsOutput in tracer/Directory.Build.props).
    That path is gitignored and per-target-framework, so the target frameworks never race on it.

    Deliberately an MSBuild target rather than a source generator: Datadog.Trace.csproj sets
    EmitCompilerGeneratedFiles with CompilerGeneratedFilesOutputPath pointing at Generated/, and
    those 500+ files are committed. A version source generator would rewrite a tracked file on
    every build, dirtying the working tree and breaking the verify_source_generators CI check.

    The templates use one item per line and avoid blank lines, because MSBuild rejects an empty
    Include. Leading indentation is written as %20 escapes because MSBuild trims item Include
    values. The leading auto-generated comment stops the analyzers running over the result.
  -->
  <PropertyGroup Condition="'$(DD_GenerateVersionSource)' != ''">
    <DD_GeneratedVersionSourceFile>$(IntermediateOutputPath)DatadogVersion.g.cs</DD_GeneratedVersionSourceFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(DD_GenerateVersionSource)' != ''">
    <!-- A literal path, not a glob, so the item exists from evaluation onward and design-time
         builds in the IDE see it before the first real build has produced it. -->
    <Compile Include="$(DD_GeneratedVersionSourceFile)" />
  </ItemGroup>

  <!--
    Deliberately no Inputs/Outputs: the content depends on version.props, on the resolved channel in
    artifacts/version/Version.g.props and on the templates in this file, and an incremental check
    keyed on only one of those silently serves a stale file. WriteOnlyWhenDifferent already makes
    this a no-op read when nothing changed, so MSBuild's up-to-date checks see an unchanged file.
  -->
  <Target Name="DD_GenerateVersionSource"
          BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime"
          Condition="'$(DD_GenerateVersionSource)' != ''">

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <ItemGroup Condition="'$(DD_GenerateVersionSource)' == 'TracerConstants'">
      <DD_VersionSourceLine Include="// &lt;auto-generated/&gt; Generated from version.props by build/Version.targets." />
      <DD_VersionSourceLine Include="// Do not edit, and do not commit - this is written into the intermediate output directory." />
      <DD_VersionSourceLine Include="namespace Datadog.Trace" />
      <DD_VersionSourceLine Include="{" />
      <DD_VersionSourceLine Include="%20%20%20%20internal static partial class TracerConstants" />
      <DD_VersionSourceLine Include="%20%20%20%20{" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;summary&gt;The four-part assembly version, e.g. 3.56.0.0. Never carries a suffix.&lt;/summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20public const string AssemblyVersion = &quot;$(DD_FourPartVersion)&quot;%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// The three-part numeric version, e.g. 3.56.0. Never carries a suffix: Instrumentation.cs" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// compares this against the native tracer's PROFILER_VERSION for an exact string match." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;/summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20public const string ThreePartVersion = &quot;$(DD_ThreePartVersion)&quot;%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// The full semantic version, e.g. 3.56.0 or 3.56.0-dev.g1a2b3c4d. This is the only" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// shape that identifies a specific build." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;/summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20public const string SemanticVersion = &quot;$(DD_SemVer)&quot;%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// The version reported to Datadog - telemetry headers, span tags, statsd tags, the stats" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// and Data Streams payloads, and telemetry.sdk.version." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;para&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// Equal to &lt;see cref=&quot;AssemblyVersion&quot;/&gt; on a release build, which is what these sites" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// have always reported, and to &lt;see cref=&quot;SemanticVersion&quot;/&gt; on a dev build so the" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// specific build can be identified. The shape therefore differs between channels." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;/para&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;/summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20public const string ReportedVersion = &quot;$(DD_ReportedVersion)&quot;%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20/// &lt;summary&gt;Gets the UTF-8 encoded &lt;see cref=&quot;ReportedVersion&quot;/&gt;, for MessagePack payloads.&lt;/summary&gt;" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20public static System.ReadOnlySpan&lt;byte&gt; ReportedVersionBytes =&gt; &quot;$(DD_ReportedVersion)&quot;u8%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20}" />
      <DD_VersionSourceLine Include="}" />
    </ItemGroup>

    <ItemGroup Condition="'$(DD_GenerateVersionSource)' == 'LoaderAssemblyName'">
      <DD_VersionSourceLine Include="// &lt;auto-generated/&gt; Generated from version.props by build/Version.targets." />
      <DD_VersionSourceLine Include="// Do not edit, and do not commit - this is written into the intermediate output directory." />
      <DD_VersionSourceLine Include="namespace Datadog.Trace.ClrProfiler.Managed.Loader" />
      <DD_VersionSourceLine Include="{" />
      <DD_VersionSourceLine Include="%20%20%20%20public sealed partial class Startup" />
      <DD_VersionSourceLine Include="%20%20%20%20{" />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20// internal so ManagedProfilerAssemblyResolver can reference it. Safe because const strings are inlined at compile time." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20// Do not add non-const static members on Startup that the resolver needs - that would re-introduce the .cctor deadlock." />
      <DD_VersionSourceLine Include="%20%20%20%20%20%20%20%20internal const string AssemblyName = &quot;Datadog.Trace, Version=$(DD_FourPartVersion), Culture=neutral, PublicKeyToken=def86d061d0d2eeb&quot;%3B" />
      <DD_VersionSourceLine Include="%20%20%20%20}" />
      <DD_VersionSourceLine Include="}" />
    </ItemGroup>

    <Error Condition="'@(DD_VersionSourceLine)' == ''"
           Text="Unknown DD_GenerateVersionSource template '$(DD_GenerateVersionSource)'. See build/Version.targets." />

    <WriteLinesToFile File="$(DD_GeneratedVersionSourceFile)"
                      Lines="@(DD_VersionSourceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <DD_VersionSourceLine Remove="@(DD_VersionSourceLine)" />
    </ItemGroup>
  </Target>

</Project>
